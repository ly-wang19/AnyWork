{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://anywork.dev/schemas/claims.schema.json",
  "title": "AnyWork claims ledger",
  "type": "object",
  "required": ["schema_version", "as_of", "claims"],
  "properties": {
    "schema_version": {"const": 1},
    "as_of": {"type": "string", "format": "date"},
    "claims": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["id", "status", "scope", "evidence"],
        "properties": {
          "id": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
          "status": {"enum": ["verified", "partial", "not-verified"]},
          "scope": {"type": "string", "minLength": 1},
          "evidence": {"type": "array", "items": {"type": "string", "minLength": 1}, "uniqueItems": true}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
