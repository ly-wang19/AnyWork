{
  "id": "codex",
  "version": 1,
  "status": "stable",
  "target_family": "agent-skills",
  "official_documentation": "https://learn.chatgpt.com/docs/build-skills#where-codex-loads-local-skills",
  "targets": {
    "user": "~/.agents/skills",
    "project": ".agents/skills"
  },
  "skill_file": "SKILL.md",
  "ui_metadata": "agents/openai.yaml",
  "portable_frontmatter_allowlist": [
    "name",
    "description",
    "license",
    "compatibility",
    "metadata"
  ],
  "strip_paths": [],
  "copy_mode": "directory",
  "install_executes_skill_code": false
}
